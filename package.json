{
  "name": "dterminal",
  "version": "0.1.0",
  "description": "Xshell-style SSH terminal client for Linux",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "postinstall": "electron-rebuild -f -w node-pty",
    "start": "electron .",
    "dist": "electron-builder"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.1.0",
    "ssh2": "^1.15.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.dterminal.app",
    "productName": "DTerminal",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  }
}
